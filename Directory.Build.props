<Project>
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks-WPF>net10.0-windows10.0.19041.0</TargetFrameworks-WPF>
    <Version>2.2.2</Version>
    <Authors>Christian Borck</Authors>
    <PackageTags>reactiveui node network editor node-editor graph</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://www.github.com/Borck/FINE</RepositoryUrl>
    <RepositoryType>Github</RepositoryType>
    <PackageIcon>logo128.png</PackageIcon>
    <PackageReadmeFile>$(MSBuildThisFileDirectory)README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <RootNamespace>FINE</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- The .NET SDK refuses to even restore/build a Windows-targeted TFM on a non-Windows OS
         unless this is set - needed for CI (ubuntu-latest) and any other non-Windows dev machine.
         Left OS-conditional so a real Windows build still gets the SDK's normal (stricter) checks. -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets\logo128.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
