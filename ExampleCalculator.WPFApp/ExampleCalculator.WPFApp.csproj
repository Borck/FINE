<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworks-WPF)</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <StartupObject>ExampleCalculatorApp.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FINEToolkit.WPF\FINEToolkit.WPF.csproj" />
    <ProjectReference Include="..\FINE.WPF\FINE.WPF.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="ReactiveUI.Reactive" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="5.1.2" />
    <PackageReference Include="ReactiveUI.Reactive" Version="24.0.0" />
    <PackageReference Include="ReactiveUI.WPF.Reactive" Version="24.0.0" />
  </ItemGroup>
</Project>
